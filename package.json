{
  "name": "sherpa-review-monorepo",
  "description": "Sherpa monorepo, a local code review tool with an AI route through a PR diff",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "docs:endpoints": "node scripts/protocol-endpoints.mjs --write",
    "build:package": "node scripts/build-package.mjs",
    "changeset": "changeset add",
    "ci:changesets": "changeset status --since=origin/main",
    "ci:version": "changeset version",
    "ci:publish": "pnpm run build:package && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}

{
    "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
    "changelog": ["@changesets/changelog-github", { "repo": "Nodge/sherpa-review" }],
    "commit": false,
    "fixed": [],
    "linked": [],
    "access": "public",
    "baseBranch": "main",
    "changedFilePatterns": [
        "src/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/dev/**",
        "package.json",
        "*.mjs",
        "!*.test.mjs",
        "!vitest.config.*",
        "vite.config.ts",
        "index.html"
    ],
    "updateInternalDependencies": "patch",
    "ignore": ["@sherpa/e2e"]
}

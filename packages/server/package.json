{
  "name": "@sherpa/server",
  "version": "0.0.0",
  "description": "Single-PR server: HTTP and SSE, database, task queue, orchestrators and host adapters",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testkit": "./src/testkit.ts"
  },
  "scripts": {
    "build": "node build-server.mjs",
    "dev": "tsx src/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run"
  },
  "dependencies": {
    "@sherpa/fixtures": "workspace:*",
    "@sherpa/protocol": "workspace:*",
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sherpa/ui": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}

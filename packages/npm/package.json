{
  "name": "sherpa-review",
  "version": "0.11.1",
  "description": "Local code review with an AI route through a PR diff, run by the agent in your harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "echo \"sherpa-review: nothing to typecheck\"",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sherpa/cli": "workspace:*",
    "@sherpa/server": "workspace:*"
  }
}
